[Unit]
Description=Ace scraper - genera la playlist M3U da livetv.sx

[Service]
Type=oneshot
WorkingDirectory=%h/ace-scraper
Environment=PYTHONUNBUFFERED=1
Environment=OUTPUT_PATH=%h/ace-scraper/www/playlist.m3u
Environment=STATS_PATH=%h/ace-scraper/www/last_run.json
Environment=ACESTREAM_PORT=6878
# Al boot la rete puo' non essere ancora pronta: aspetta fino a 60s che il DNS risolva livetv.sx
ExecStartPre=/bin/sh -c 'for i in $$(seq 30); do getent hosts livetv.sx >/dev/null && exit 0; sleep 2; done; exit 0'
ExecStart=%h/ace-scraper/venv/bin/python m3u_generator.py
TimeoutStartSec=300
Nice=10
